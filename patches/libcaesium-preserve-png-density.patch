+fn parse_png(data: Vec<u8>) -> Result<Png, CaesiumError> {
+    Png::from_bytes(Bytes::from(data)).map_err(|e| CaesiumError {
+        message: format!("Cannot preserve PNG density: {}", e),
+        code: 20213,
+    })
+}
+
+fn restore_density(data: Vec<u8>, density: Option<PngChunk>) -> Result<Vec<u8>, CaesiumError> {
+    let mut png = parse_png(data)?;
+    // Replace, rather than duplicate, any density generated by the encoder.
+    // Absence of source density is preserved too.
+    png.remove_chunks_by_type(*b"pHYs");
+    if let Some(chunk) = density {
+        png.chunks_mut().insert(1, chunk); // After IHDR, before IDAT, as PNG requires.
+    }
+    let mut output = Vec::new();
+    png.encoder().write_to(&mut output).map_err(|e| CaesiumError {
+        message: e.to_string(),
+        code: 20213,
+    })?;
+    Ok(output)
 }
 
