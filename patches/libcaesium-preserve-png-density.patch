+#[cfg(test)]
+mod ppi_tests {
+    use super::*;
+
+    fn fixture(density: Option<(u32, u32, u8)>) -> Vec<u8> {
+        let pixels: Vec<lodepng::RGBA> = (0..256).map(|i| lodepng::RGBA {
+            r: i as u8, g: (255 - i) as u8, b: 80, a: if i % 3 == 0 { 0 } else { 128 },
+        }).collect();
+        let data = lodepng::encode32(&pixels, 16, 16).unwrap();
+        let chunk = density.map(|(x, y, unit)| {
+            let mut contents = Vec::new();
+            contents.extend_from_slice(&x.to_be_bytes());
+            contents.extend_from_slice(&y.to_be_bytes());
+            contents.push(unit);
+            PngChunk::new(*b"pHYs", Bytes::from(contents))
+        });
+        restore_density(data, chunk).unwrap()
+    }
+
+    fn assert_density(input: &[u8], output: &[u8]) {
+        let original = parse_png(input.to_vec()).unwrap();
+        let result = parse_png(output.to_vec()).unwrap();
+        assert_eq!(original.chunk_by_type(*b"pHYs"), result.chunk_by_type(*b"pHYs"));
+        assert!(result.chunks_by_type(*b"pHYs").count() <= 1);
+        if let Some(index) = result.chunks().iter().position(|c| c.kind() == *b"pHYs") {
+            assert!(index < result.chunks().iter().position(|c| c.kind() == *b"IDAT").unwrap());
+        }
+    }
+
+    #[test]
+    fn preserves_density_with_and_without_resize() {
+        for density in [Some((11811, 11811, 1)), Some((5669, 11339, 1)), Some((4, 3, 0)), None] {
+            for lossless in [false, true] {
+                for size in [0, 8] {
+                    let input = fixture(density);
+                    let mut params = CSParameters::new();
+                    params.keep_metadata = true;
+                    params.optimize = lossless;
+                    params.png.quality = 95;
+                    params.width = size;
+                    params.height = size;
+                    let output = compress_in_memory(input.clone(), &params).unwrap();
+                    assert_density(&input, &output);
+                    let decoded = lodepng::decode32(&output).unwrap();
+                    assert_eq!((decoded.width, decoded.height), if size == 0 { (16, 16) } else { (8, 8) });
+                    if lossless && size == 0 {
+                        assert_eq!(decoded.buffer, lodepng::decode32(&input).unwrap().buffer);
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn metadata_does_not_change_compressed_pixels_or_palette() {
+        let input = fixture(Some((11811, 11811, 1)));
+        let mut params = CSParameters::new();
+        params.png.quality = 95;
+        let without = compress_in_memory(input.clone(), &params).unwrap();
+        assert!(parse_png(without.clone()).unwrap().chunk_by_type(*b"pHYs").is_none());
+        params.keep_metadata = true;
+        let with = compress_in_memory(input, &params).unwrap();
+        assert_eq!(restore_density(with.clone(), None).unwrap(), without);
+        assert_eq!(with.len(), without.len() + 21);
+        assert_eq!(lodepng::decode32(with).unwrap().buffer, lodepng::decode32(without).unwrap().buffer);
+    }
+
+    #[test]
+    fn file_and_target_size_paths_preserve_density() {
+        let input = fixture(Some((11811, 11811, 1)));
+        let mut params = CSParameters::new();
+        params.keep_metadata = true;
+        params.width = 8;
+        params.height = 8;
+        let dir = std::env::temp_dir().join(format!("caesium-ppi-{}", std::process::id()));
+        fs::create_dir_all(&dir).unwrap();
+        let source = dir.join("source.png");
+        let target = dir.join("target.png");
+        fs::write(&source, &input).unwrap();
+        compress(source.to_str().unwrap().into(), target.to_str().unwrap().into(), &params).unwrap();
+        assert_density(&input, &fs::read(&target).unwrap());
+        let output = crate::compress_to_size_in_memory(input.clone(), &mut params, 4096, true).unwrap();
+        assert_density(&input, &output);
+        fs::remove_file(source).unwrap();
+        fs::remove_file(target).unwrap();
+        fs::remove_dir(dir).unwrap();
+    }
+}
